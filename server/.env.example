DATABASE_URL="mysql://root:password@localhost:3306/zunuz_db"
# Long random strings (32+ bytes each), different from each other.
JWT_SECRET="change-me"
JWT_ADMIN_SECRET="change-me"
PORT=3001
# Must be exactly "production" on the live server (turns off dev-only
# behaviour: localhost CORS, email preview routes, stack traces).
NODE_ENV=production
# Comma-separated list of allowed frontend origins (custom domain(s) + the raw *.vercel.app URL).
# The FIRST one is used for links in emails.
CLIENT_URL="http://localhost:5173"
# Public address of this API (e.g. https://zunuz-production.up.railway.app) —
# used for uploaded-file links and the newsletter List-Unsubscribe header.
API_PUBLIC_URL=

# OAuth 2.0 Client ID from Google Cloud Console (same value as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (Resend HTTPS API — SMTP is blocked on most hosts). Without a key,
# emails are only logged, not sent.
RESEND_API_KEY=
RESEND_FROM="ZUNUZ <hello@yourdomain.com>"

# Only for `npm run db:seed` on a fresh database (12+ characters). Not needed at runtime.
SEED_ADMIN_PASSWORD=

# Local development only — returns OTPs / reset links in API responses.
# NEVER set this on the live server.
# EXPOSE_DEV_SECRETS=1
